{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haus-webauthn",
  "main": "worker.ts",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "WEBAUTHN_KV",
      "id": "83b34227eb464e99b3131dab9586122a"
    }
  ],
  "build": {
    "command": "npm run build"
  }
}
