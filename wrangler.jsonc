{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haus-webauthn",
  "main": "worker.ts",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "CRM_ENDPOINT": "https://script.google.com/macros/s/AKfycbwhBycqlcQUB6SOYGVy2tPDJFk0-aT5vc--8YiFznpZslbpz_zrtgFBsumt7KnzPVhi/exec",
    "RP_ID": "haus.art.br",
    "ORIGIN": "https://haus.art.br"
  },
  "kv_namespaces": [
    {
      "binding": "WEBAUTHN_KV",
      "id": "83b34227eb464e99b3131dab9586122a"
    }
  ],
  "build": {
    "command": "npm run build"
  }
}
